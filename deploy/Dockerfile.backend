# Backend Dockerfile for Fleek IPRS
# Build: docker build -f deploy/Dockerfile.backend -t fleek-iprs-backend .
# Run: docker run -p 8787:8787 --env-file .env fleek-iprs-backend

FROM node:22-alpine AS base

# Install dependencies for native modules (sqlite3, bcrypt, etc.)
RUN apk add --no-cache python3 make g++ sqlite-dev

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy source
COPY . .

# Build
RUN npm run build

# Expose port
EXPOSE 8787

# Start
CMD ["node", "server/index.mjs"]