{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "dev:all": "node server/index.mjs & vite",
    "build": "vite build",
    "format": "prettier --write eslint.config.js vitest.config.ts tsconfig.json server/passwords.d.mts tests package.json .prettierrc",
    "lint": "eslint src server tests vitest.config.ts",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:reset": "node -e \"require('fs').rmSync('server/.data',{recursive:true,force:true});console.log('database cleared — reseeds on next start')\"",
    "smoke:dom": "node scripts/smoke-dom.mjs",
    "smoke:flows": "node scripts/smoke-flows.mjs",
    "smoke:pdf": "SMOKE_DUMP_DIR=.smoke-artifacts node scripts/smoke-dom.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run smoke:api && npm run smoke:dom && npm run smoke:flows && npm run smoke:trace",
    "smoke:trace": "node scripts/smoke-requirements.mjs",
    "smoke:api": "node scripts/smoke-api.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.46.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
